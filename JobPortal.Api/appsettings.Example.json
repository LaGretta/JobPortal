{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=JobPortal;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Key": "ЗАМІНИ: випадковий рядок, не коротше 32 символів",
    "Issuer": "JobPortal",
    "Audience": "JobPortalClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "BlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=ЗАМІНИ;AccountKey=ЗАМІНИ;EndpointSuffix=core.windows.net",
    "ContainerName": "resumes"
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "ЗАМІНИ: пошта відправника",
    "Password": "ЗАМІНИ: App Password Gmail, не звичайний пароль",
    "FromName": "JobPortal",
    "FromAddress": "ЗАМІНИ: та сама пошта",
    "ResetUrlBase": "http://localhost:5173/reset-password"
  },

  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },

  "Admin": {
    "Email": "admin@jobportal.local",
    "Password": "ЗАМІНИ: пароль адміна",
    "FirstName": "Адмін",
    "LastName": "Системи"
  }
}
